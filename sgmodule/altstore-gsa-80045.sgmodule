#!name=AltStore GSA -80045 Experimental - TLS Blocked
#!desc=已观察到 iOS GSA 域名 TLS 校验阻断：完全信任 CA 后仍可能拒绝 MITM，无法进入重写。该模块不是已验证可用的 iOS 修复，请停用；详见仓库 docs/altstore-gsa-80045.md。保留代码仅供研究。

# Remote script is hosted in this repository and downloaded by Surge.
# Uses the JSC scripting engine; no external JavaScript libraries.

[MITM]
hostname = %INSERT% gsa.apple.com

[Script]
GSA80045-Login = type=http-request,pattern=^https://gsa\.apple\.com/grandslam/GsService2/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/CodeDuckky/surge-mihomo-rules/main/scripts/altstore-gsa-fix.js,requires-body=true,max-size=65536,full-header-mode=true,engine=jsc,timeout=10
GSA80045-Verification = type=http-request,pattern=^https://gsa\.apple\.com/(?:auth/verify/trusteddevice/?|grandslam/GsService2/validate/?)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/CodeDuckky/surge-mihomo-rules/main/scripts/altstore-gsa-fix.js,full-header-mode=true,engine=jsc,timeout=10
GSA80045-Response = type=http-response,pattern=^https://gsa\.apple\.com/grandslam/GsService2/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/CodeDuckky/surge-mihomo-rules/main/scripts/altstore-gsa-fix.js,requires-body=true,max-size=262144,full-header-mode=true,engine=jsc,timeout=10
